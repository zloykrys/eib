apiVersion: 1.3
image:
  imageType: iso
  arch: x86_64
  baseImage: slemicro.iso
  outputImageName: eib-image.iso
operatingSystem:
  isoConfiguration:
    installDevice: /dev/vda
  packages:
    noGPGCheck: false
    sccRegistrationCode: "{{ scc_registration_code }}"
    packageList:
      - nfs-client
      - rpcbind
  kernelArgs:
    - selinux=0
  users:
    - username: root
      encryptedPassword: $6$jHugJNNd3HElGsUZ$eodjVe4te5ps44SVcWshdfWizrP.xAyd71CVEXazBJ/.v799/WRCBXxfYmunlBO2yp1hm/zb4r8EmnrrNCF.P/
    - username: user
      encryptedPassword: $6$jHugJNNd3HElGsUZ$eodjVe4te5ps44SVcWshdfWizrP.xAyd71CVEXazBJ/.v799/WRCBXxfYmunlBO2yp1hm/zb4r8EmnrrNCF.P/
      createHomeDir: true
      sshKeys:
        - "{{ user_ssh_key }}"

kubernetes:
  version: v1.36.3+rke2r1
  network:
      apiHost: rancher-dev.demo.com
      apiVIP: 172.16.33.10
  nodes:
    - hostname: rke2-1.demo.com
      type: server
      initializer: true
    - hostname: rke2-2.demo.com
      type: server
    - hostname: rke2-3.demo.com
      type: server
  manifests:
    urls:
    - https://github.com/cert-manager/cert-manager/releases/download/v1.20.1/cert-manager.crds.yaml
  helm:
    charts:
      - name: rancher
        version: 2.15.1
        repositoryName: rancher-prime
        valuesFile: rancher-values.yaml
        targetNamespace: cattle-system
        createNamespace: true
        installationNamespace: kube-system
      - name: cert-manager
        installationNamespace: kube-system
        createNamespace: true
        repositoryName: jetstack
        targetNamespace: cert-manager
        version: 1.20.1

# SUSE Security / NeuVector

      - name: neuvector-crd
        version: 110.0.1+up2.11.1
        repositoryName: rancher-charts
        targetNamespace: cattle-neuvector-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: neuvector-crd.yaml
      - name: neuvector
        version: 110.0.1+up2.11.1
        repositoryName: rancher-charts
        targetNamespace: cattle-neuvector-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: neuvector-values.yaml
      - name: neuvector-monitor
        version: 110.0.1+up2.11.1
        repositoryName: rancher-charts
        targetNamespace: cattle-neuvector-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: neuvector-monitor.yaml

# CloudNativePG

      - name: cloudnative-pg
        repositoryName: appco
        version: 0.29.1
        targetNamespace: cloudnativepg
        createNamespace: true
        installationNamespace: kube-system

# CSI driver
      - name: kubernetes-csi-driver-nfs
        repositoryName: appco
        version: 4.13.4
        targetNamespace: kubernetes-csi-driver-nfs
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: kubernetes-csi-driver-nfs-values.yaml

# Harbor registry

      - name: harbor
        repositoryName: appco
        version: 1.19.2
        targetNamespace: harbor-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: harbor.yaml

# Compliance Operator
      - name: rancher-compliance-crd
        repositoryName: rancher-charts
        version: 110.2.0+up1.5.1
        targetNamespace: compliance-operator-system
        createNamespace: true
        installationNamespace: kube-system
      - name: rancher-compliance
        repositoryName: rancher-charts
        version: 110.2.0+up1.5.1
        targetNamespace: compliance-operator-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: compliance-operator.yaml

# Rancher-monitoring
      - name: rancher-monitoring-crd
        repositoryName: rancher-charts
        version: 110.0.1+up80.9.1
        targetNamespace: cattle-monitoring-system
        createNamespace: true
        installationNamespace: kube-system
      - name: rancher-monitoring
        repositoryName: rancher-charts
        version: 110.0.1+up80.9.1
        targetNamespace: cattle-monitoring-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: rancher-monitoring.yaml

# Rancher-logging
      - name: rancher-logging-crd
        repositoryName: rancher-charts
        version: 110.0.0+up4.10.0
        targetNamespace: cattle-logging-system
        createNamespace: true
        installationNamespace: kube-system
      - name: rancher-logging
        repositoryName: rancher-charts
        version: 110.0.0+up4.10.0
        targetNamespace: cattle-logging-system
        createNamespace: true
        installationNamespace: kube-system
        valuesFile: rancher-logging.yaml

    repositories:
      - name: jetstack
        url: https://charts.jetstack.io
      - name: rancher-prime
        url: https://charts.rancher.com/server-charts/prime
      - name: rancher-charts
        url: https://charts.rancher.io/
      - name: appco
        url: oci://dp.apps.rancher.io/charts
        plainHTTP: false
        authentication:
          username: "{{ appco_repo_username }}"
          password: "{{ appco_repo_password }}"

